# ---------------------------------------------------------------------
# Copy this file to ".env.local" and fill in your keys.
# The site RUNS WITHOUT any of these (it falls back to demo data),
# but you need them for real products, logins, payments and email.
#
# Vercel / production: keep the NEXT_PUBLIC_ prefix on every variable
# that has it below. Next.js will NOT expose SUPABASE_URL (without
# NEXT_PUBLIC_) to the browser — auth, Maps, and client fetches break,
# and the shop falls back to mock prints with gradient placeholders.
# ---------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by payment webhooks to mark orders paid. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Doron Goldstein Photography <orders@dgwlp.co.za>"

# PayFast (https://www.payfast.co.za) — use sandbox values while testing
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Public site origin — production must be your live domain (not localhost).
# Also set the same value as Site URL in Supabase → Authentication → URL Configuration,
# and add Redirect URLs: https://your-domain/auth/callback and http://localhost:3000/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_SITE_IMAGES=true

# Google Maps Places autocomplete (checkout + registration address)
# Enable "Maps JavaScript API" + "Places API" for the key, restrict to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Obscure admin URL (bookmark this — it is never linked in the public nav).
# Example: /ops-doron   — leave as /admin only for local demos.
NEXT_PUBLIC_ADMIN_PATH=/admin

# Contact form inbox (defaults to the address in EMAIL_FROM)
CONTACT_TO=
